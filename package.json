{
  "name": "storefront-blocks",
  "version": "0.1.0",
  "private": true,
  "description": "Tested, ready-made sections (blocks) the site editor's webmaster copies into a shadcn/Tailwind Next.js storefront.",
  "type": "module",
  "scripts": {
    "dev": "next dev showcase --port 3910",
    "build": "next build showcase",
    "start": "next start showcase --port 3910",
    "manifest": "node scripts/build-manifest.mjs",
    "check-types": "npm run manifest && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "check-design": "node scripts/check-design.mjs",
    "test": "vitest run",
    "check": "npm run manifest && npm run check-types && npm run lint && npm run check-design && npm run test",
    "thumbs": "node scripts/thumbs.mjs",
    "example-shots": "node scripts/example-shots.mjs"
  },
  "dependencies": {
    "@nicgo101/storefront-commerce": "^1.22.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "gql.tada": "^1.9.0",
    "lucide-react": "^0.544.0",
    "next": "^16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.1",
    "jsdom": "^27.2.0",
    "playwright": "^1.58.2",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.1.8"
  }
}
