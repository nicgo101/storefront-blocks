{
  "id": "product-spotlight",
  "version": 1,
  "name": "Produkt i fokus",
  "category": "commerce",
  "tier": "shop",
  "summary": "En produkt stort på startsidan eller en kampanjsida: bild, namn, pris från butiken och en knapp till produktsidan. Egen säljtext för just den här platsen.",
  "files": [{ "path": "product-spotlight.tsx", "target": "src/components/blocks/product-spotlight.tsx" }],
  "uses": { "ui": ["button"], "packages": ["@nicgo101/storefront-commerce", "next"], "site": [] },
  "props": [
    { "name": "slug", "type": "string", "required": true },
    { "name": "eyebrow", "type": "string" },
    { "name": "title", "type": "string" },
    { "name": "text", "type": "string" },
    { "name": "image", "type": "{ src: string; alt: string; width: number; height: number }" },
    { "name": "buttonLabel", "type": "string", "default": "Till produkten" },
    { "name": "imageSide", "type": "'left' | 'right'", "default": "left" }
  ],
  "thumbnail": "thumb.png"
}
