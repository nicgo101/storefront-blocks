{
  "id": "video-embed",
  "version": 1,
  "name": "Video från YouTube eller Vimeo",
  "category": "media",
  "tier": "generic",
  "summary": "En inbäddad video som laddas först när besökaren klickar på play. Inga kakor från videotjänsten innan dess.",
  "files": [{ "path": "video-embed.tsx", "target": "src/components/blocks/video-embed.tsx" }],
  "uses": { "ui": [], "packages": ["next", "lucide-react"], "site": [] },
  "props": [
    { "name": "title", "type": "string | null", "default": null },
    { "name": "text", "type": "string" },
    { "name": "provider", "type": "'youtube' | 'vimeo'", "required": true },
    { "name": "videoId", "type": "string", "required": true },
    { "name": "videoTitle", "type": "string", "required": true },
    { "name": "poster", "type": "{ src: string; alt: string; width: number; height: number }" },
    { "name": "width", "type": "'narrow' | 'wide'", "default": "wide" }
  ],
  "thumbnail": "thumb.png"
}
