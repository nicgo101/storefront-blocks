{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": {
      "@/components/blocks/*": ["./blocks/*"],
      "@/*": ["./showcase/src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": ["blocks/**/*.ts", "blocks/**/*.tsx", "showcase/src/**/*.ts", "showcase/src/**/*.tsx", "vitest.setup.ts"],
  "exclude": ["node_modules", "showcase/.next"]
}
